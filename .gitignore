# Go
/luna
/bin/luna
/dist/
*.test
*.out
coverage.out

# Local state
*.db
*.db-shm
*.db-wal

# System
.DS_Store

# Local developer tooling, not project configuration: the ai-jail sandbox marker
# and the durable-memory scope. Both exist in the worktree and are needed to work
# here — they just do not belong in the repository.
.ai-jail
.ai-memory.toml

# Per-developer harness settings. `.local` is the convention for "yours, not the
# project's" — permissions one person granted on one machine are not something a
# clone should inherit.
.claude/
