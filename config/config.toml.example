# Luna project configuration. Copy to .luna/config.toml to use.
#
# Everything here is optional: a project with no config file behaves the same as
# one with an empty one.

# Which editor `luna gate adjust` opens when a gate carries an artifact for
# review. It may carry arguments.
#
# This wins over $EDITOR, because $EDITOR serves your git and this project may
# want something else — a repository whose contracts are long markdown is not
# obliged to open them in the editor that writes commit messages.
#
# Resolution order, most specific first:
#   1. this setting
#   2. $LUNA_EDITOR   — overrides the project for one invocation
#   3. $EDITOR
#   4. $VISUAL
editor = "vim"

# Which official harness `luna chat` asks to understand what you said. Luna hosts
# no model: it runs one of claude, pi, codex or opencode non-interactively and
# reads the command back. Defaults to claude.
#
# interpreter = "pi"

# ── how supervised a run is ──────────────────────────────────────────────────
#
# Two things decide it, and neither of them lives here.
#
# **Whether a gate waits** is the stage's own declaration: a gate stops when the
# stage file gives it judgement criteria, or when the task's registry entry gives
# it checks to run. A gate with neither was never going to put a question in
# front of anybody, so it does not wait (ADR-0063). You edit that in
# `.luna/stock/stages/`, beside the gate it governs.
#
#   [gate]
#   kind        = "review-artifact"
#   artifact    = "contract"
#   criticality = 9
#   judge = [
#     "The contract states what is required and what is forbidden",
#   ]
#
# **Who answers one that waited** is the autonomy knob, set per task:
#
#   luna autonomy LUNA-1        # show it
#   luna autonomy LUNA-1 7      # the lead judges gates up to criticality 7
#
# 0 is the default and judges nothing. 10 lets the lead judge every gate — and a
# lead judging honestly still asks when it cannot decide. Moving it writes an
# event, so the log says when it changed; a gate already open keeps the answer it
# opened with (RFC-0006).
#
# Declared checks are answered by their exit code before any of that, so a gate
# whose commands pass is answered with no model involved. They are declared per
# task, in the registry, because they vary per task:
#
#   bd create "..." --metadata '{"luna_gates": {
#      "approve-spec": {"checks": ["make ci"]}
#   }}'

# ── profiles ─────────────────────────────────────────────────────────────────
#
# A profile now decides exactly one thing: how long to wait on an agent that has
# stopped reacting before calling the task stuck. It used to decide which gates
# wait, and no longer does (ADR-0063) — a `waits` key here is refused rather than
# ignored, because a file that reads like supervision and decides nothing is
# worse than one that will not load.
#
# One budget bounds a whole turn, tool time included (ADR-0051). It defaults to
# 2h. There is deliberately no wall-clock cap on the task: progress, not elapsed
# time, is the signal worth acting on.
#
# The profile is chosen per task (`luna task new LUNA-1 --profile nightly`) and
# recorded in its log, so a replay reproduces the run as it happened.

# [profile.nightly]
# turn_budget = "45m"

# A profile of your own — this one gives a long-running build more room before
# the watchdog calls it stuck.
# [profile.patient]
# turn_budget = "4h"

# ── roles ────────────────────────────────────────────────────────────────────
#
# A role is what a stage asks for: `build` wants an implementer, `code-review`
# wants a reviewer. Each one resolves to the agent that runs it, what it is told
# about being that role, and the skills it loads.
#
# Twelve roles ship with the default flow — scout, analyst, investigator,
# gherkin, specifier, implementer, cleaner, verifier, qa, reviewer, hardener,
# architect. Naming one here replaces just that one; the rest keep their
# defaults, because the flow names roles this file never mentions.
#
# `agent` is one of the kinds herdr supports. Putting a different model behind
# `reviewer` than behind `implementer` is the cheapest independence available —
# and it is not the separation INV-core-7 asks for, which needs the reviewer to
# not HAVE Edit and Write rather than to be told not to use them.

# A role may also declare what it must NOT be able to do. The four review roles
# — qa, reviewer, hardener, architect — ship denying Edit and Write, because a
# role that judges someone else's work must not be able to change it. The brief
# says so too, and the brief is not what enforces it: a restriction that lives
# only in the prompt is exactly what INV-core-7 names as the violation.
#
# `tools_deny` names the capability, never a harness's spelling of it. claude
# says `Edit`, pi says `edit`, codex takes no names at all and denies writing
# with a sandbox mode — Luna translates. That is what lets you move a role
# between agents without rewriting it.
#
# Luna can gate claude, pi, codex and opencode. A gated role on any other agent
# stops the stage rather than running ungated.

# [role.reviewer]
# agent      = "codex"
# brief      = "You review. You report findings; you do not edit."
# skills     = ["code-review"]
# tools_deny = ["Edit", "Write"]

# [role.implementer]
# agent = "claude"
