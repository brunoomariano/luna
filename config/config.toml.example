# Luna project configuration. Copy to .luna/config.toml to use.
#
# Everything here is optional: a project with no config file behaves the same as
# one with an empty one.

# Which editor `luna gate adjust` opens when a gate carries an artifact for
# review. It may carry arguments.
#
# This wins over $EDITOR, because $EDITOR serves your git and this project may
# want something else. Resolution order, most specific first:
#   1. this setting
#   2. $LUNA_EDITOR
#   3. $EDITOR
#   4. $VISUAL
editor = "vim"

# Which official harness the lead asks when it judges a gate. Luna hosts no
# model: it runs one of claude, pi, codex or opencode non-interactively and reads
# the answer back. This is not the agent that runs a stage; each embedded stage
# declares its own agent policy. Defaults to claude.
#
# lead_harness = "pi"

# -- how supervised a run is --------------------------------------------------
#
# Two things decide it, and neither lives in this file.
#
# Whether a gate waits is the stage's declaration in the flow embedded in the
# Luna binary, or the checks recorded on this task with `luna gate checks`. A
# project cannot override a stage, its agent, brief, tools or gate here. Those
# are flow control and change with the binary under review.
#
# Who answers a gate that waited is the autonomy knob, set per task:
#
#   luna autonomy LUNA-1        # show it
#   luna autonomy LUNA-1 7      # the lead judges gates up to autonomy floor 7
#
# Zero is the default and judges nothing. Ten lets the lead judge every gate,
# while a lead that cannot decide still asks. Moving the knob writes an event;
# a gate already open keeps the answer it opened with.
#
# Declared checks are answered by their exit code before judgement. They vary by
# task, so one task may need the whole suite and another something narrower:
#
#   luna gate checks LUNA-1 --on review-artifact --run "make ci"
#
# `--run` repeats and keeps its order; the first failure is the answer. With no
# --run, the gate is declared to have no mechanical answer and goes straight to
# judgement, which differs from declaring nothing.

# -- the watchdog -------------------------------------------------------------
#
# How long to wait on an agent that has stopped reacting before calling the task
# stuck. One budget bounds a whole turn, tool time included, and defaults to 2h.
# It is project-wide because suite duration is a fact about the repository, not
# about who answers a gate. There is no wall-clock cap on the whole task.
#
# turn_budget = "45m"

# -- preparing worktrees ------------------------------------------------------
#
# The command that turns a fresh checkout into one whose tests can run. Luna
# executes it in each new stage worktree before starting the agent. Empty means
# the repository needs no preparation.
#
# bootstrap = "make bootstrap"

# -- durable agent memory -----------------------------------------------------
#
# The ai-memory workstream this project's tasks use unless `task new` names a
# different one. Every checkout of one project should use the same durable
# context. Defaults to "luna".
#
# workstream = "the-project"

# -- profiles -----------------------------------------------------------------
#
# A profile holds only its name. A task records the profile it was created under
# so replay reproduces the run, and `--profile` validates against the names here.
# The shipped names are interactive, turbo and nightly. Defining no profiles
# keeps all three. Every key inside a profile is refused rather than ignored.

# [profile.patient]
