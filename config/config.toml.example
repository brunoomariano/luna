# Luna project configuration. Copy to .luna/config.toml to use.
#
# Everything here is optional: a project with no config file behaves the same as
# one with an empty one.

# Which editor `luna gate adjust` opens when a gate carries an artifact for
# review. It may carry arguments.
#
# This wins over $EDITOR, because $EDITOR serves your git and this project may
# want something else — a repository whose contracts are long markdown is not
# obliged to open them in the editor that writes commit messages.
#
# Resolution order, most specific first:
#   1. this setting
#   2. $LUNA_EDITOR   — overrides the project for one invocation
#   3. $EDITOR
#   4. $VISUAL
editor = "vim"

# ── gate profiles ────────────────────────────────────────────────────────────
#
# A profile names which gates stop a task and wait for a person. It is chosen per
# task (`luna task new LUNA-1 --profile turbo`), because the kind of work does not
# predict the risk: a critical bug can deserve more gating than a trivial feature.
#
# Three come installed — interactive (stops at everything), turbo (stops only
# before the write) and nightly (stops at nothing). Naming any profile below
# replaces that set with yours, so copy the ones you still want. Redefining a
# shipped name is allowed: it is how you adjust turbo rather than work around it.
#
# The gate kinds a profile may name:
#
#   confirm           a yes or no, with nothing attached
#   confirm-write     the confirmation before the task writes — the commit
#   review-artifact   the human reads what a stage produced, and may edit it
#   loop-ceiling      a loop that stopped converging and needs a decision
#
# Editing a profile changes what tasks do from here on. It does not change what
# past tasks replay to: each task's log records what its gates actually decided,
# so history stays what happened (ADR-0026).

# A profile also decides how long to wait on an agent that has stopped reacting
# before calling the task stuck. Two windows, because a real build runs silent
# for many minutes and an agent that stopped does not:
#
#   idle_budget   nothing is running and the agent is not reacting
#   tool_budget   a tool is in flight; a compile is not a stall
#
# Both are optional and default to 30m / 2h. There is deliberately no wall-clock
# cap: progress, not elapsed time, is the signal worth acting on.
#
# The profile that waits at no gate has nobody watching, which makes its watchdog
# the only net — so it is usually the one worth tightening.

# [profile.interactive]
# waits = ["confirm", "confirm-write", "review-artifact", "loop-ceiling"]

# [profile.turbo]
# waits = ["confirm-write"]

# [profile.nightly]
# waits = []
# idle_budget = "15m"
# tool_budget = "1h"

# A profile of your own — this one reviews the contract but trusts the rest.
# [profile.spec-only]
# waits = ["review-artifact", "confirm-write"]
